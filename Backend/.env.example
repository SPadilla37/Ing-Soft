# =============================
# Core app
# =============================
PROJECT_NAME=Habilio API
VERSION=1.0.0
API_V1_STR=/api/v1
FRONTEND_URL=http://localhost:3000

# =============================
# Security/Auth
# =============================
SECRET_KEY=change-this-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30

# =============================
# Database
# =============================
DATABASE_URL=sqlite:///./skillswap.db

# =============================
# Email (optional)
# =============================
MAIL_USERNAME=dummy@example.com
MAIL_PASSWORD=dummy
MAIL_FROM=dummy@example.com
MAIL_PORT=587
MAIL_SERVER=smtp.gmail.com
MAIL_FROM_NAME=Habilio Notificaciones
MAIL_STARTTLS=true
MAIL_SSL_TLS=false
USE_CREDENTIALS=true
VALIDATE_CERTS=true

# =============================
# Admin bootstrap
# =============================
BOOTSTRAP_ADMIN_ENABLED=true
BOOTSTRAP_ADMIN_EMAIL=admin@ingsoft.app
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=Admin123!

# =============================
# Text moderation
# strict | medium | relaxed
# =============================
TEXT_MODERATION_LEVEL=medium
TEXT_MODERATION_ENABLE_PROFANITY=true
# Comma-separated custom blocked terms.
# Suggested starter set (adjust to your policy and locale):
# acoso,amenaza,pornografia,doxxing,estafa,hostigamiento
TEXT_MODERATION_EXTRA_BLOCKED_TERMS=acoso,amenaza,pornografia,doxxing,estafa,hostigamiento
